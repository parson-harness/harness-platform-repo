################################################################################
# Sandbox Environment - Example Configuration
# Copy this file to terraform.tfvars and fill in your values
################################################################################

#===============================================================================
# REQUIRED - Owner Identification
#===============================================================================
owner = "your-last-name"  # Your last name or POV name (used for resource naming)

#===============================================================================
# REQUIRED - Harness Configuration
#===============================================================================
harness_account_id = "your-harness-account-id"
harness_api_key    = "your-harness-api-key"
delegate_version   = "26.02.88600"

# Harness cluster endpoint - must match your account's cluster location
# Check: Account Settings → Account Overview → Harness Cluster Location
#   SE Sandbox accounts (prod-2): https://app.harness.io/gratis
#   Customer POV accounts (prod-1): https://app.harness.io  (default)
#   prod-3 accounts:               https://app3.harness.io
# harness_endpoint = "https://app.harness.io/gratis"

# harness_delegate_token is optional - Terraform creates a project-scoped token automatically.
# Only set this if you want to use a pre-existing token instead.
# harness_delegate_token = "your-delegate-token"

#===============================================================================
# DEPLOYMENT TARGET (Use Case Selection)
#===============================================================================
# Choose which deployment targets to configure. This controls:
# - Service definition type (Kubernetes, ECS, Lambda)
# - Infrastructure definitions created (K8s, ECS, Lambda)
# - Required connectors and permissions
#
# Options: "eks", "ecs", "lambda", "asg"
# Can specify multiple: ["eks", "ecs"] for multi-target POVs

# EKS only (default)
deployment_targets = ["eks"]

# ECS only
# deployment_targets = ["ecs"]

# Lambda only
# deployment_targets = ["lambda"]

# Multi-target POV (EKS + ECS)
# deployment_targets = ["eks", "ecs"]

# ASG only (EC2 Auto Scaling Groups - Blue/Green, Canary, Rolling)
# deployment_targets = ["asg"]

# Full AWS demo (all targets)
# deployment_targets = ["eks", "ecs", "lambda", "asg"]

#===============================================================================
# Harness Organization Configuration
#===============================================================================
# Option 1: Use existing organization (default)
create_harness_org = false
harness_org_id     = "default"  # Your existing org ID

# Option 2: Create new organization
# create_harness_org   = true
# new_harness_org_id   = "harness_reference_architecture"
# new_harness_org_name = "Harness Reference Architecture"

#===============================================================================
# Harness Project Configuration
#===============================================================================
# Option 1: Use existing project (default)
create_harness_project = false
harness_project_id     = "your-project-id"  # Your existing project ID

# Option 2: Create new project (auto-named based on owner)
# create_harness_project   = true
# new_harness_project_id   = ""  # Leave empty for auto: "<owner>_demo"
# new_harness_project_name = ""  # Leave empty for auto: "<Owner> Demo"

#===============================================================================
# Cluster Configuration (for EKS deployments)
#===============================================================================
# Option 1: Use existing EKS cluster (recommended for quick setup)
create_eks_cluster    = false
existing_cluster_name = "harness-eks-parson"  # Your existing cluster name

# Option 2: Create new EKS cluster (takes ~20 min, may hit AWS limits)
# create_eks_cluster    = true
# existing_cluster_name = ""
# vpc_cidr              = "10.0.0.0/16"
# enable_nat_gateway    = true
# kubernetes_version    = "1.29"
# node_instance_types   = ["t3.medium"]
# node_capacity_type    = "SPOT"
# node_desired_size     = 2

#===============================================================================
# Delegate Configuration
#===============================================================================
create_delegate = true   # Set to false to use existing delegate

#===============================================================================
# IRSA Configuration (recommended for EKS)
#===============================================================================
enable_irsa = true

#===============================================================================
# Harness Service & Environment Configuration
#===============================================================================
create_harness_service     = true
create_harness_environment = true
create_prod_environment    = true  # Creates both Dev and Prod environments

# Service manifest configuration (for GitHub-based manifests)
# service_git_repo       = "harness-demo-app"
# service_git_branch     = "main"
# service_manifest_paths = ["k8s/"]

# ECS manifest paths (if using ECS)
# ecs_task_definition_paths    = ["ecs/taskdef.json"]
# ecs_service_definition_paths = ["ecs/servicedef.json"]

# ECS cluster name (required if ecs in deployment_targets)
# ecs_cluster_name = "my-ecs-cluster"

#===============================================================================
# Connector Configuration
#===============================================================================
create_connectors = true

# GitHub connector (optional - for manifest/pipeline source)
# github_url       = "https://github.com/your-org"
# github_token_ref = "account.github_token"
# github_token_ref = "parson-gh-pat"

#===============================================================================
# Artifact Registry Configuration
#===============================================================================
# Choose where to store Docker images:
#   "har" = Harness Artifact Registry (default, recommended)
#   "ecr" = AWS ECR (requires AWS permissions)

artifact_registry_type = "har"  # Default: Harness Artifact Registry

# For ECR:
# artifact_registry_type = "ecr"

# DockerHub upstream proxy (for HAR - avoids rate limits)
create_dockerhub_upstream = true
# dockerhub_username            = "your-dockerhub-username"
# dockerhub_password_secret_ref = "account.dockerhub_password"

#===============================================================================
# Continuous Verification (CV) Configuration
#===============================================================================
# CV requires a Prometheus connector and monitored service.
# When enabled, the canary pipeline will include a Verify step that
# analyzes metrics during deployment.

enable_cv = false  # Set to true to enable CV

#===============================================================================
# ASG Configuration (only used when "asg" is in deployment_targets)
#
# Architecture: Packer bakes the JAR + JDK directly into an AMI (no Docker).
# The CI pipeline builds the JAR then runs Packer to create an AMI.
# Harness CD uses AmazonMachineImage as the artifact type.
# User data is minimal - writes env vars and starts the pre-installed systemd service.
#
# Creates: self-contained VPC, ALB (HTTPS:443 prod, HTTP:8080 stage),
#          Launch Template, base ASG, EC2 instance profile, Harness ASG pipeline
#
# PREREQUISITE: Create these Harness secrets before running the CI pipeline:
#   aws_access_key_id     - AWS access key with EC2 AMI creation permissions
#   aws_secret_access_key - Corresponding AWS secret key
#   (IAM needs: ec2:RunInstances, ec2:StopInstances, ec2:CreateImage,
#               ec2:CreateTags, ec2:DescribeImages, ec2:DescribeInstances,
#               ec2:DescribeVolumes, ec2:TerminateInstances)
#===============================================================================
# asg_instance_type     = "t3.small"    # EC2 instance type (default: t3.small)
# asg_vpc_cidr          = "10.2.0.0/16" # VPC CIDR (separate from EKS VPC)
# asg_desired_capacity  = 0             # 0 = no instances until first Harness deploy
# asg_max_size          = 4             # Max instances per deployed ASG
# asg_canary_instance_count = 1         # Canary instances during canary deploy
# create_asg_strategy_pipeline = true   # Creates the B/G+Canary+Rolling pipeline
#
# DNS (uses existing harness-demo.dev wildcard cert):
# asg_create_dns_record = true           # Creates <owner>.asg.harness-demo.dev
# route53_zone_name     = "harness-demo.dev"  # Default, usually no need to change
#
# Packer AWS credentials are fully automated:
# - IAM user "harness-packer-ci-<owner>" is created with minimal AMI-build permissions
# - Access key is generated and stored as project-scoped Harness secrets automatically
# - No manual credential management required
#
# Harness secret identifiers (change only if using external/shared credentials):
# asg_packer_aws_access_key_secret  = "aws_access_key_id"
# asg_packer_aws_secret_key_secret  = "aws_secret_access_key"
#
# After apply with asg target, use these outputs:
#   asg_app_url       - Production URL (https://<owner>.asg.harness-demo.dev)
#   asg_stage_url     - Stage URL (http://<owner>.asg.harness-demo.dev:8080)
#   asg_alb_dns_name  - Raw ALB DNS if DNS record not created
#   asg_pipeline_id   - Run this pipeline in Harness to deploy

# CV settings (only used when enable_cv = true)
cv_sensitivity = "Medium"  # High, Medium, Low
cv_duration    = "5m"      # Analysis duration

# Prometheus URL - creates connector automatically
# For in-cluster Prometheus: http://prometheus.monitoring.svc.cluster.local:9090
# prometheus_url = "http://prometheus.monitoring.svc.cluster.local:9090"

# Or use existing connector reference
# prometheus_connector_ref = "prometheus"
